body{
  font-family:var(--font-space-grotesk),Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0a0a0a;color:#f5f4ff}button{font:inherit;cursor:pointer}a{color:inherit;text-decoration:none}.site{min-height:100vh;background:#0a0a0a;transition:.2s}.site.dark{background:#0c0d14;color:#f5f4ff}.topbar{height:78px;border-bottom:1px solid #eeeef6;display:flex;align-items:center;padding:0 32px;gap:44px;position:sticky;top:0;background:rgba(255,255,255,.92);backdrop-filter:blur(16px);z-index:10}.dark .topbar{background:rgba(12,13,20,.92);border-color:#222333}.brand{display:flex;align-items:center;gap:10px;font-size:23px;white-space:nowrap}.brandMark{display:grid;place-items:center;width:35px;height:35px;border-radius:10px;background:#6b42f4;color:white;font-weight:900;font-size:27px;line-height:1;box-shadow:0 7px 22px #7044f42b}.brand b span{color:#6b42f4}nav{display:flex;align-items:center;gap:29px;height:100%;flex:1}nav a{font-size:14px;font-weight:600;color:#303246;height:100%;display:flex;align-items:center;border-bottom:2px solid transparent}.dark nav a{color:#bdbbd0}nav .active{color:#6540ed;border-color:#6b42f4}.headerActions{display:flex;align-items:center;gap:12px}.network,.theme{border:1px solid #e2e1ec;background:#fff;border-radius:12px;height:44px;padding:0 14px;color:#27283b}.dark .network,.dark .theme{background:#171823;border-color:#2a2b3a;color:#eee}.network i{display:inline-block;width:8px;height:8px;border-radius:50%;background:#19b878;margin-right:8px}.network span{margin-left:14px}.wallet,.primary{border:0;background:#6840ef;color:#fff;border-radius:11px;height:44px;padding:0 23px;font-weight:700;box-shadow:0 8px 24px #6840ef2b}.theme{width:44px;padding:0;font-size:19px}.page{max-width:1240px;margin:auto;padding:46px 28px 0}.hero{min-height:350px;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:15px 26px 20px;overflow:hidden}.eyebrow{display:inline-flex;border:1px solid #ddd5ff;color:#6840ef;background:#faf8ff;border-radius:30px;padding:8px 13px;font-size:12px;font-weight:700;margin-bottom:24px}.hero h1{font-size:57px;line-height:1.02;letter-spacing:-2.5px;margin:0 0 18px}.hero h1 .accent{color:#6b42f4}.heroCopy p{font-size:17px;line-height:1.65;color:#5c5d70;max-width:500px;margin:0 0 25px}.dark .heroCopy p{color:#a8a7ba}.heroBtns{display:flex;gap:13px}.secondary{height:44px;border:1px solid #dedee8;background:#fff;border-radius:11px;padding:0 22px;color:#292a3d;font-weight:650}.dark .secondary{background:#171823;color:#eee;border-color:#2b2c3b}.heroOrb{height:310px;position:relative;display:grid;place-items:center}.r3d{font-size:190px;font-weight:1000;color:#8d62ff;text-shadow:12px 16px 0 #d8caff,20px 25px 45px #7650ef35;transform:perspective(500px) rotateY(-10deg);z-index:2}.orbital{position:absolute;border:1px solid #ddd2ff;border-radius:50%;width:430px;height:130px;transform:rotate(-12deg)}.o2{width:300px;height:90px;transform:rotate(28deg);opacity:.65}.stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #e8e6f1;border-radius:15px;background:#fff;box-shadow:0 8px 30px #29204408;margin:5px 0 55px}.dark .stats,.dark .feature,.dark .panel,.dark .game,.dark .newsletter,.dark .security{background:#151621;border-color:#28293a}.stat{display:flex;gap:15px;align-items:center;padding:24px 25px;border-right:1px solid #eceaf2}.stat:last-child{border:0}.statIcon,.featureIcon{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:#f0eaff;color:#6b42f4;font-size:21px}.stat div{position:relative;flex:1}.stat small{display:block;color:#66677b;font-size:12px;margin-bottom:4px}.stat b{font-size:19px}.stat em{font-size:11px;color:#13a56c;font-style:normal;margin-left:8px}.stat label{display:block;color:#8c8d9c;font-size:10px;margin-top:3px}.section{margin-bottom:38px}.sectionHead{display:flex;align-items:end;justify-content:space-between;margin-bottom:20px}.sectionHead h2{font-size:20px;margin:0 0 4px}.sectionHead p{margin:0;color:#77788b;font-size:13px}.linkBtn,.panelHead button{border:1px solid #e6e4ed;background:#fff;border-radius:9px;padding:9px 13px;font-size:12px;color:#5e3bea;font-weight:650}.featureGrid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.feature,.game,.panel,.newsletter,.security{background:#fff;border:1px solid #e7e5ee;border-radius:14px;box-shadow:0 8px 28px #2b1b5c07}.feature{padding:22px 20px;min-height:190px}.featureIcon{margin-bottom:18px}.feature h3,.game h3{font-size:15px;margin:0 0 8px}.feature p,.game p{color:#67687b;font-size:12px;line-height:1.55;margin:0 0 18px}.feature button{border:0;background:none;padding:0;color:#6340e8;font-size:12px;font-weight:700}.security{display:flex;align-items:center;gap:16px;padding:17px 22px;margin:20px 0 37px;background:linear-gradient(90deg,#fbf9ff,#fff)}.shield{width:45px;height:45px;border-radius:12px;background:#eee7ff;color:#6941ed;display:grid;place-items:center;font-size:25px}.security b{font-size:13px}.security p{margin:3px 0 0;color:#7b7c8e;font-size:11px}.security button{margin-left:auto;border:1px solid #b9a7ff;background:#fff;color:#6941ed;border-radius:9px;padding:9px 18px;font-size:11px;font-weight:700}.gameGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.game{padding:8px 8px 13px}.gameImage{height:155px;border-radius:10px;background:linear-gradient(135deg,#24124c,#7750ed 55%,#d9d0ff);position:relative;display:grid;place-items:center;overflow:hidden}.gameImage span{font-size:76px;filter:drop-shadow(0 12px 18px #0005)}.gameImage em{position:absolute;right:8px;top:8px;background:#6b42f4;color:#fff;border-radius:6px;padding:4px 7px;font-size:9px;font-style:normal;font-weight:800}.game h3{margin:13px 9px 3px}.game p{margin:0 9px 4px}.game small{color:#858698;font-size:10px;margin-left:9px}.game button{width:calc(100% - 18px);margin:10px 9px 0;height:34px;background:#fff;border:1px solid #bcaeff;color:#6840ef;border-radius:8px;font-size:11px;font-weight:700}.lowerGrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin:45px 0}.panel{padding:18px}.panelHead{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;font-size:13px}.panelHead button{border:0;padding:0}.market{display:grid;grid-template-columns:1.4fr 1fr .7fr;align-items:center;padding:13px 0;border-bottom:1px solid #eeeef3}.market:last-child{border:0}.market b{font-size:12px;display:block}.market small{font-size:9px;color:#898a9a}.market strong{font-size:11px}.market em{font-size:10px;color:#12a46b;font-style:normal;text-align:right}.neg{color:#ee5252!important}.tx{display:grid;grid-template-columns:35px 1fr auto;gap:10px;align-items:center;padding:13px 0;border-bottom:1px solid #eeeef3}.tx:last-child{border:0}.tx>span{width:35px;height:35px;border-radius:50%;display:grid;place-items:center;background:#f0eaff;color:#6b42f4}.tx b{display:block;font-size:11px}.tx small{font-size:9px;color:#888999}.txRight{text-align:right}.txRight strong{font-size:10px;color:#12a46b;display:block}.comi{border-radius:14px;padding:20px;background:linear-gradient(145deg,#7146ed,#9b78f6);color:#fff;box-shadow:0 14px 35px #6b42f42b}.comiTop{display:flex;justify-content:space-between;font-size:13px}.comiTop span{font-size:9px;color:#d7ffe9}.bot{width:65px;height:65px;border-radius:50%;background:#fff;color:#6340e8;display:grid;place-items:center;font-size:20px;margin:18px auto 10px}.comi h3{margin:0;text-align:center;font-size:15px}.comi h3 strong{color:#e6ddff}.comi>p{text-align:center;font-size:11px;line-height:1.5;color:#eee8ff}.chips{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:15px}.chips button{border:1px solid #ffffff3d;background:#ffffff12;color:#fff;border-radius:8px;padding:8px 5px;font-size:9px}.ask{margin-top:10px;background:#fff1;border:1px solid #ffffff35;border-radius:9px;padding:11px;color:#ded6ff;font-size:10px}.ask b{float:right;background:#fff;color:#7045ee;border-radius:6px;padding:4px 6px;margin-top:-5px}.newsletter{display:flex;align-items:center;gap:15px;padding:20px 25px;margin-bottom:25px}.mailIcon{width:45px;height:45px;border-radius:12px;background:#eee7ff;color:#6840ef;display:grid;place-items:center}.newsletter h3{font-size:14px;margin:0 0 3px}.newsletter p{font-size:10px;color:#77788b;margin:0}.subscribe{margin-left:auto;display:flex;gap:8px}.subscribe input{height:38px;border:1px solid #e2e0ea;border-radius:8px;padding:0 13px;width:230px;outline:0}.subscribe button{height:38px;border:0;border-radius:8px;background:#6840ef;color:#fff;padding:0 18px;font-size:11px;font-weight:700}.trusted{display:flex;align-items:center;justify-content:space-between;color:#8a8b99;font-size:11px;padding:18px 0 50px}.trusted span{color:#67687a}.trusted div{font-weight:700;letter-spacing:1px}footer{border-top:1px solid #eeeef4;max-width:1185px;margin:auto;padding:38px 28px 55px;display:grid;grid-template-columns:2fr repeat(4,1fr);gap:35px;position:relative}footer p{font-size:10px;line-height:1.7;color:#858697}footer>b,footer div>b{display:block;font-size:11px;margin-bottom:13px}footer a{display:block;font-size:10px;color:#77788a;margin:8px 0}footer>small{position:absolute;right:28px;bottom:18px;color:#999aaa;font-size:9px}.dark footer{border-color:#252635}.dark .secondary,.dark .game button,.dark .linkBtn,.dark .security button,.dark .subscribe input{background:#171823;color:#eee;border-color:#303144}.dark .newsletter p,.dark .sectionHead p,.dark .feature p,.dark .game p,.dark .stat small{color:#a4a3b4}.dark .market,.dark .tx{border-color:#292a39}.dark .feature button,.dark .panelHead button{color:#a993ff}@media(max-width:1050px){nav{gap:14px}.topbar{gap:18px;padding:0 18px}.featureGrid{grid-template-columns:repeat(3,1fr)}.lowerGrid{grid-template-columns:1fr 1fr}.comi{grid-column:span 2}}@media(max-width:760px){.topbar{height:auto;min-height:68px;flex-wrap:wrap;padding:12px 15px}.topbar nav{order:3;overflow:auto;width:100%;height:42px;flex:none}.headerActions{margin-left:auto}.network{display:none}.page{padding:25px 15px}.hero{grid-template-columns:1fr;padding:15px 8px;min-height:auto}.heroOrb{display:none}.hero h1{font-size:43px}.stats{grid-template-columns:1fr 1fr}.stat{border-bottom:1px solid #eceaf2}.featureGrid,.gameGrid{grid-template-columns:1fr 1fr}.lowerGrid{grid-template-columns:1fr}.comi{grid-column:auto}.newsletter{flex-wrap:wrap}.subscribe{margin-left:0;width:100%}.subscribe input{flex:1;width:auto}.trusted{display:none}footer{grid-template-columns:1fr 1fr;padding-bottom:70px}.brand{font-size:19px}}@media(max-width:470px){.featureGrid,.gameGrid,.stats{grid-template-columns:1fr}.hero h1{font-size:38px}.wallet{padding:0 13px;font-size:11px}.theme{display:none}.stats .stat{border-right:0}.newsletter{padding:18px}.subscribe input{width:100%}.subscribe{flex-direction:column}.subscribe button{width:100%}}

/* ===== RialoVerse animation layer ===== */
@keyframes floatR{0%,100%{transform:perspective(500px) rotateY(-10deg) translateY(0) rotateZ(-1deg)}50%{transform:perspective(500px) rotateY(-6deg) translateY(-14px) rotateZ(1deg)}}
@keyframes orbitA{from{transform:rotate(-12deg) rotate(0deg)}to{transform:rotate(-12deg) rotate(360deg)}}
@keyframes orbitB{from{transform:rotate(28deg) rotate(360deg)}to{transform:rotate(28deg) rotate(0deg)}}
@keyframes pulseSoft{0%,100%{opacity:.35;transform:scale(1)}50%{opacity:.75;transform:scale(1.06)}}
@keyframes riseIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
@keyframes botFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
@keyframes dotPulse{0%,100%{box-shadow:0 0 0 0 #19b87833}50%{box-shadow:0 0 0 7px #19b87800}}
.heroCopy{animation:riseIn .7s ease both}.heroOrb{animation:riseIn .8s .1s ease both}
.r3d{animation:floatR 4.5s ease-in-out infinite}.o1{animation:orbitA 18s linear infinite}.o2{animation:orbitB 14s linear infinite}
.heroOrb:after{content:"";position:absolute;width:210px;height:80px;border-radius:50%;background:#7045ef22;filter:blur(30px);animation:pulseSoft 3.5s ease-in-out infinite}
.stats{animation:riseIn .7s .15s ease both}
.stat{transition:transform .25s ease,background .25s ease}.stat:hover{transform:translateY(-4px);background:#fcfbff}
.feature,.game{transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease}
.feature:hover{transform:translateY(-8px);box-shadow:0 18px 40px #5e3bea18;border-color:#cfc3ff}
.featureIcon{transition:transform .3s ease,box-shadow .3s ease}.feature:hover .featureIcon{transform:scale(1.08) rotate(-5deg);box-shadow:0 8px 22px #6b42f426}
.game:hover{transform:translateY(-7px);box-shadow:0 18px 40px #2b1b5c18;border-color:#cfc3ff}
.gameImage:after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 25%,#ffffff22 48%,transparent 70%);background-size:220% 100%;opacity:0;transition:opacity .2s}
.game:hover .gameImage:after{opacity:1;animation:shimmer 1.2s ease}.gameImage span{transition:transform .35s ease}.game:hover .gameImage span{transform:scale(1.1) translateY(-3px)}
.wallet,.primary,.secondary,.linkBtn,.feature button,.game button,.security button{transition:transform .2s ease,box-shadow .2s ease,background .2s ease}
.wallet:hover,.primary:hover{transform:translateY(-2px);box-shadow:0 12px 30px #6840ef3d}
.secondary:hover,.linkBtn:hover,.security button:hover,.game button:hover{transform:translateY(-2px);box-shadow:0 8px 20px #6840ef12}
.comi{position:relative;overflow:hidden}.comi:before{content:"";position:absolute;width:170px;height:170px;border-radius:50%;background:#ffffff0e;top:-90px;right:-55px;animation:pulseSoft 4s ease-in-out infinite}
.bot{animation:botFloat 3s ease-in-out infinite}.comiTop span{animation:dotPulse 2s ease-in-out infinite}.network i{animation:dotPulse 2s ease-in-out infinite}
.newsletter{transition:transform .25s ease,box-shadow .25s ease}.newsletter:hover{transform:translateY(-3px);box-shadow:0 14px 32px #2b1b5c0c}
nav a{transition:color .2s ease}nav a:hover{color:#6840ef}
.market,.tx{transition:background .2s ease;padding-left:7px;padding-right:7px;border-radius:8px}.market:hover,.tx:hover{background:#faf9ff}
.particle{position:absolute;color:#8a68ef;font-weight:900;z-index:3;animation:pulseSoft 3s ease-in-out infinite}.p1{top:25px;right:35px;font-size:18px}.p2{bottom:35px;left:50px;font-size:30px;animation-delay:1s}.p3{top:70px;left:90px;font-size:11px;animation-delay:1.7s}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
h1,h2,h3,.brand b{font-family:var(--font-anton),var(--font-space-grotesk),sans-serif;letter-spacing:.5px;text-transform:uppercase}
.hero h1{letter-spacing:1px;line-height:1.08}
@keyframes slideUpReveal{from{transform:translateY(115%)}to{transform:translateY(0)}}
.heroTitleMask{display:block;overflow:hidden}
.heroTitleInner{display:block;animation:slideUpReveal .9s cubic-bezier(.22,1,.36,1) both}
:root{--neon:#d7ff1f}
.site,.stats,.feature,.game,.panel,.newsletter,.security,.network,.theme,.wallet,.primary,.secondary,.linkBtn,.panelHead button,.security button,.gameImage,.gameImage em,.game button,.subscribe input,.subscribe button,.mailIcon,.shield,.comi,.ask,.ask b,.chips button,.brandMark{border-radius:0!important}
.dark .stats,.dark .feature,.dark .game,.dark .panel,.dark .newsletter,.dark .security{border-width:2px;border-color:#2a2b3a}
.dark .brandMark,.dark .wallet,.dark .primary{background:var(--neon);color:#0a0a0a;box-shadow:none}
.dark .network,.dark .theme,.dark .secondary{border-width:2px}
.dark nav .active{color:var(--neon);border-color:var(--neon)}
.dark .brand b span{color:var(--neon)}
.dark .hero h1 .accent{color:var(--neon)}
.dark .feature button,.dark .panelHead button,.dark .linkBtn{color:var(--neon)}
.dark .security{border-width:2px;border-color:var(--neon)}
.dark .security button{border-width:2px;border-color:var(--neon);color:var(--neon)}
.dark .r3d{color:var(--neon);text-shadow:12px 16px 0 #333,20px 25px 45px #00000055}
.dark .orbital{border-color:var(--neon)}
.dark .particle{color:var(--neon)}
.dark .heroOrb:after{background:#d7ff1f22}
.dark .comi{background:#0e0f16;border:2px solid var(--neon);box-shadow:none}
.dark .bot{background:var(--neon);color:#0a0a0a}
.dark .chips button{border-width:2px;border-color:var(--neon);color:var(--neon)}
.dark .ask{border-width:2px}
.dark .ask b{background:var(--neon);color:#0a0a0a}
.dark .typeCursor{color:var(--neon)}
.dark .wallet,.dark .primary{border:2px solid var(--neon)}
.secLearnMore{padding:10px 20px;background:var(--neon);color:#0a0a0a;text-decoration:none;font-weight:700;font-size:14px;border:2px solid var(--neon)}
.dark .statIcon,.dark .featureIcon{background:#1a1b26;color:var(--neon);border:2px solid var(--neon)}
.dark .shield{background:#1a1b26;color:var(--neon);border:2px solid var(--neon)}
.dark .mailIcon{background:#1a1b26;color:var(--neon);border:2px solid var(--neon)}
.dark .subscribe button{background:var(--neon);color:#0a0a0a}
.dark .subscribe input{background:#0e0f16;color:#fff;border-color:#2a2b3a}
.dark .gameImage{background:linear-gradient(135deg,#0a0a0a,#1a1b26 55%,#2a2b3a)}
.dark .gameImage em{background:var(--neon);color:#0a0a0a}
.dark .game button{border-color:var(--neon);color:var(--neon);background:#0e0f16}
.dark .tx>span{background:#1a1b26;color:var(--neon);border:2px solid var(--neon)}
.topbar{justify-content:space-between}
.hamburger{width:44px;height:44px;background:transparent;border:2px solid var(--neon);display:flex;flex-direction:column;justify-content:center;align-items:center;gap:5px}
.hamburger span{width:22px;height:2px;background:var(--neon);display:block}
.mobileMenu{position:absolute;top:78px;left:0;right:0;background:#0a0a0a;border-top:2px solid var(--neon);border-bottom:2px solid var(--neon);display:flex;flex-direction:column;z-index:20}
.mobileMenu a{padding:16px 24px;font-size:15px;font-weight:700;color:#fff;border-bottom:1px solid #1a1b26}
.mobileMenu a.active{color:var(--neon)}
.mobileMenu a:last-child{border-bottom:0}
.mobileMenu{height:auto!important;flex:none!important;gap:0!important}
.mobileMenu a{height:auto!important;display:block!important;width:100%;box-sizing:border-box}

/* =========================================================
   RIALOVERSE V2 — IMMERSIVE LANDING PAGE
   ========================================================= */

:root {
  --rv-bg: #07080c;
  --rv-panel: #0d0f15;
  --rv-panel-2: #11131b;
  --rv-border: #242834;
  --rv-text: #f4f5ed;
  --rv-muted: #858997;
  --rv-neon: #d7ff1f;
  --rv-neon-soft: #d7ff1f22;
}

/* RESET */

.rv-site {
  min-height: 100vh;
  background: var(--rv-bg);
  color: var(--rv-text);
  overflow: hidden;
}

.rv-site *,
.rv-site *::before,
.rv-site *::after {
  box-sizing: border-box;
}

.rv-site button,
.rv-site a {
  font: inherit;
}

.rv-site button {
  cursor: pointer;
}

.rv-site a {
  color: inherit;
  text-decoration: none;
}

/* NAV */

.rv-nav {
  height: 72px;
  padding: 0 34px;
  display: flex;
  align-items: center;
  gap: 50px;
  border-bottom: 1px solid #1d2029;
  background: #07080ced;
  /* backdrop-filter: blur(18px); */
  position: relative;
  position: sticky;
  top: 0;
  z-index: 1000;
}

.rv-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 16px;
  font-weight: 900;
  letter-spacing: 0.5px;
  font-family: var(--font-anton), sans-serif !important;
  text-transform: uppercase;
  white-space: nowrap;
}

.rv-brand > span:last-child > span {
  color: var(--rv-neon);
}

.rv-brand-mark {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  background: var(--rv-neon);
  color: #080900;
  font-size: 25px;
  font-weight: 1000;
}

.rv-nav-links {
  display: flex;
  align-items: center;
  gap: 32px;
  flex: 1;
}

.rv-nav-links a {
  color: #888c98;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  transition: .25s;
}

.rv-nav-links a:hover {
  color: var(--rv-neon);
}

.rv-nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.rv-wallet {
  border: 1px solid #303541;
  background: #10131a;
  color: #dce0d8;
  padding: 10px 17px;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.rv-menu {
  display: none;
  background: transparent;
  border: 0;
  padding: 5px;
}

.rv-menu span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--rv-neon);
  margin: 5px;
}

/* COMMON */

.rv-section,
.rv-intro,
.rv-how,
.rv-universe,
.rv-security,
.rv-comi,
.rv-live {
  max-width: 1240px;
  margin: auto;
  padding-left: 34px;
  padding-right: 34px;
}

.rv-section-label {
  color: #68707d;
  font-family: monospace;
  font-size: 10px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.rv-reveal {
  opacity: 0;
  transform: translateY(35px);
  transition:
    opacity .8s ease,
    transform .8s cubic-bezier(.22,1,.36,1);
}

.rv-visible {
  opacity: 1;
  transform: translateY(0);
}

/* HERO */

.rv-hero {
  min-height: 780px;
  max-width: 1400px;
  margin: auto;
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  overflow: hidden;
  padding: 90px 70px;
}

.rv-grid-bg {
  position: absolute;
  inset: 0;
  opacity: .22;
  background-image:
    linear-gradient(#ffffff08 1px, transparent 1px),
    linear-gradient(90deg, #ffffff08 1px, transparent 1px);
  background-size: 70px 70px;
  mask-image: linear-gradient(to bottom, black, transparent);
}

.rv-hero-copy {
  position: relative;
  z-index: 3;
}

.rv-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #a7adb8;
  border: 1px solid #272c36;
  padding: 9px 13px;
  font-size: 9px;
  letter-spacing: 1.7px;
  font-family: monospace;
  margin-bottom: 25px;
  background: #0b0d12;
}

.rv-live-dot {
  width: 6px;
  height: 6px;
  background: var(--rv-neon);
  border-radius: 50%;
  box-shadow: 0 0 12px var(--rv-neon);
  animation: rvPulse 2s infinite;
}

.rv-hero h1 {
  margin: 0;
  font-size: clamp(58px, 7vw, 100px);
  line-height: 1.05;
  letter-spacing: -1px;
  font-weight: 900;
}

.rv-hero h1 span {
  color: var(--rv-neon);
}

.rv-hero-copy > p {
  color: #969aa6;
  line-height: 1.7;
  font-size: 14px;
  margin: 28px 0;
}

.rv-hero-buttons {
  display: flex;
  gap: 10px;
}

.rv-primary,
.rv-secondary {
  border: 0;
  padding: 14px 20px;
  text-transform: uppercase;
  font-size: 10px;
  letter-spacing: 1px;
  display: inline-flex;
  align-items: center;
  gap: 15px;
}

.rv-primary {
  background: var(--rv-neon);
  color: #090a04;
  font-weight: 800;
}

.rv-primary span {
  font-size: 16px;
}

.rv-secondary {
  border: 1px solid #2c3039;
  background: #0e1016;
  color: #d5d8d1;
}

.rv-primary:hover {
  box-shadow: 0 0 35px #d7ff1f2b;
  transform: translateY(-2px);
}

.rv-secondary:hover {
  border-color: var(--rv-neon);
}

.rv-hero-stats {
  display: flex;
  gap: 30px;
  margin-top: 60px;
}

.rv-hero-stats div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.rv-hero-stats strong {
  font-size: 19px;
}

.rv-hero-stats span {
  color: #646a75;
  font-size: 8px;
  letter-spacing: 1.5px;
}

/* ORBIT */

.rv-orbit-scene {
  height: 560px;
  position: relative;
  display: grid;
  place-items: center;
}

.rv-core {
  width: 180px;
  height: 180px;
  border: 1px solid #d7ff1f55;
  border-radius: 50%;
  display: grid;
  place-items: center;
  position: relative;
  z-index: 5;
  box-shadow:
    0 0 70px #d7ff1f10,
    inset 0 0 50px #d7ff1f0c;
  animation: rvCore 4s ease-in-out infinite;
}

.rv-core::before,
.rv-core::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  border: 1px solid #d7ff1f20;
}

.rv-core::before {
  inset: -18px;
}

.rv-core::after {
  inset: -38px;
}

.rv-core span {
  color: var(--rv-neon);
  font-size: 115px;
  font-weight: 1000;
  line-height: 1;
  text-shadow: 0 0 35px #d7ff1f55;
}

.rv-orbit {
  position: absolute;
  border: 1px solid #d7ff1f32;
  border-radius: 50%;
}

.orbit-one {
  width: 500px;
  height: 190px;
  transform: rotate(-20deg);
  animation: rvOrbit 16s linear infinite;
}

.orbit-two {
  width: 440px;
  height: 170px;
  transform: rotate(52deg);
  animation: rvOrbitReverse 20s linear infinite;
}

.orbit-three {
  width: 580px;
  height: 240px;
  transform: rotate(82deg);
  opacity: .4;
  animation: rvOrbit 26s linear infinite;
}

.rv-orbit-node {
  position: absolute;
  z-index: 8;
  border: 1px solid #323741;
  background: #0c0f14;
  padding: 9px 12px;
  color: #aeb4bd;
  font: 9px monospace;
  letter-spacing: 1px;
  box-shadow: 0 0 20px #000;
}

.node-one {
  top: 120px;
  right: 5%;
}

.node-two {
  bottom: 95px;
  left: 4%;
}

.node-three {
  top: 210px;
  left: 2%;
}

.node-four {
  bottom: 125px;
  right: 7%;
}

.rv-star {
  position: absolute;
  color: var(--rv-neon);
  animation: rvBlink 3s infinite;
}

.star-one {
  top: 90px;
  right: 15%;
}

.star-two {
  bottom: 70px;
  left: 15%;
  animation-delay: 1s;
}

.star-three {
  top: 45%;
  right: 2%;
  animation-delay: 2s;
}

.rv-scroll {
  position: absolute;
  bottom: 22px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 10px;
  color: #565b65;
  font: 8px monospace;
  letter-spacing: 2px;
}

.rv-scroll i {
  width: 1px;
  height: 35px;
  background: linear-gradient(var(--rv-neon), transparent);
}

/* INTRO */

.rv-intro {
  padding-top: 150px;
  padding-bottom: 150px;
}

.rv-intro-content {
  max-width: 950px;
  margin: 45px auto 0;
}

.rv-intro h2,
.rv-how h2,
.rv-universe h2,
.rv-security h2,
.rv-comi h2,
.rv-cta h2 {
  font-size: clamp(42px, 6vw, 75px);
  line-height: 1.1;
  letter-spacing: -0.5px;
  margin: 0;
}

.rv-intro h2 span,
.rv-how h2 span,
.rv-universe h2 span,
.rv-security h2 span,
.rv-comi h2 span,
.rv-cta h2 span {
  color: var(--rv-neon);
}

.rv-intro-content p {
  max-width: 520px;
  margin: 35px 0 0 auto;
  color: #7e838e;
  line-height: 1.8;
  font-size: 13px;
}

/* FEATURE */

.rv-section {
  padding-top: 100px;
  padding-bottom: 140px;
}

.rv-section-top {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 50px;
}

.rv-section-top h2 {
  font-size: 38px;
  margin: 12px 0 0;
  letter-spacing: 0px;
}

.rv-section-top > p {
  color: #707580;
  font-size: 12px;
  line-height: 1.7;
  text-align: right;
}

.rv-feature-layout {
  display: grid;
  grid-template-columns: 370px 1fr;
  min-height: 510px;
  border-top: 1px solid var(--rv-border);
  border-bottom: 1px solid var(--rv-border);
}

.rv-feature-list {
  border-right: 1px solid var(--rv-border);
}

.rv-feature-item {
  width: 100%;
  min-height: 100px;
  display: grid;
  grid-template-columns: 35px 45px 1fr 30px;
  align-items: center;
  gap: 10px;
  padding: 0 22px;
  border: 0;
  border-bottom: 1px solid #1b1e26;
  background: transparent;
  color: #747985;
  text-align: left;
  transition: .3s;
}

.rv-feature-item:hover,
.rv-feature-item.active {
  background: #10131a;
  color: var(--rv-text);
}

.rv-feature-item.active {
  box-shadow: inset 3px 0 var(--rv-neon);
}

.rv-feature-number {
  font: 9px monospace;
  color: #525762;
}

.rv-feature-icon {
  width: 34px;
  height: 34px;
  border: 1px solid #303540;
  display: grid;
  place-items: center;
  color: var(--rv-neon);
}

.rv-feature-name {
  text-transform: uppercase;
  font-size: 11px;
  letter-spacing: 1px;
  font-weight: 700;
}

.rv-feature-arrow {
  opacity: .5;
}

.rv-feature-display {
  position: relative;
  overflow: hidden;
  background: #090b10;
  padding: 55px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.rv-display-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(#ffffff07 1px, transparent 1px),
    linear-gradient(90deg, #ffffff07 1px, transparent 1px);
  background-size: 45px 45px;
  mask-image: linear-gradient(to bottom, black, transparent);
}

.rv-display-orb {
  position: absolute;
  width: 340px;
  height: 340px;
  border-radius: 50%;
  border: 1px solid #d7ff1f25;
  right: 10%;
  top: 18%;
  display: grid;
  place-items: center;
  animation: rvCore 5s ease-in-out infinite;
}

.rv-display-orb::before {
  content: "";
  position: absolute;
  inset: 35px;
  border: 1px dashed #d7ff1f20;
  border-radius: 50%;
}

.rv-display-orb span {
  font-size: 100px;
  color: var(--rv-neon);
  z-index: 2;
}

.rv-display-content {
  position: relative;
  z-index: 4;
  max-width: 470px;
}

.rv-display-content > span {
  font: 9px monospace;
  color: #626873;
  letter-spacing: 2px;
}

.rv-display-content h3 {
  font-size: 50px;
  margin: 12px 0;
  color: var(--rv-neon);
}

.rv-display-content h4 {
  font-size: 19px;
  margin: 0 0 15px;
}

.rv-display-content p {
  color: #777d87;
  font-size: 12px;
  line-height: 1.7;
  max-width: 380px;
}

.rv-display-content a {
  display: inline-block;
  margin-top: 20px;
  color: var(--rv-neon);
  font: 10px monospace;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.rv-display-status {
  position: absolute;
  right: 20px;
  bottom: 18px;
  color: #5d626d;
  font: 8px monospace;
}

.rv-display-status span {
  display: inline-block;
  width: 5px;
  height: 5px;
  background: var(--rv-neon);
  border-radius: 50%;
  margin-right: 7px;
}

/* HOW */

.rv-how {
  padding-top: 130px;
  padding-bottom: 150px;
  border-top: 1px solid #191c24;
}

.rv-how > h2 {
  margin-top: 40px;
}

.rv-how-intro {
  color: #777d87;
  font-size: 13px;
  margin: 25px 0 80px;
}

.rv-timeline {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid #282c34;
}

.rv-step {
  min-height: 260px;
  padding: 28px 25px;
  border-right: 1px solid #282c34;
  position: relative;
}

.rv-step:last-child {
  border-right: 0;
}

.rv-step-number {
  color: var(--rv-neon);
  font: 10px monospace;
}

.rv-step-line {
  width: 7px;
  height: 7px;
  background: var(--rv-neon);
  border-radius: 50%;
  margin: 25px 0;
  box-shadow: 0 0 15px #d7ff1f88;
}

.rv-step h3 {
  font-size: 16px;
  margin: 0 0 12px;
}

.rv-step p {
  color: #737984;
  font-size: 11px;
  line-height: 1.7;
  max-width: 190px;
}

/* UNIVERSE */

.rv-universe {
  max-width: none;
  padding-top: 130px;
  padding-bottom: 140px;
  background:
    radial-gradient(circle at 50% 50%, #d7ff1f08, transparent 35%),
    #080a0e;
  border-top: 1px solid #191c24;
}

.rv-universe > .rv-section-label,
.rv-universe-title,
.rv-network {
  max-width: 1170px;
  margin-left: auto;
  margin-right: auto;
}

.rv-universe-title {
  display: flex;
  justify-content: space-between;
  margin-top: 40px;
}

.rv-universe-title p {
  color: #737984;
  max-width: 260px;
  font-size: 12px;
  line-height: 1.7;
}

.rv-network {
  height: 620px;
  margin-top: 70px;
  position: relative;
}

.rv-network-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 150px;
  height: 150px;
  border: 1px solid #d7ff1f44;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 0 80px #d7ff1f0e;
}

.rv-network-center strong {
  color: var(--rv-neon);
  font-size: 65px;
}

.rv-network-center span {
  font: 7px monospace;
  letter-spacing: 2px;
  color: #646a75;
}

.rv-network-line {
  position: absolute;
  height: 1px;
  background: linear-gradient(90deg, transparent, #d7ff1f55, transparent);
  transform-origin: center;
  animation: rvLine 3s ease-in-out infinite;
}

.line-a {
  width: 330px;
  left: calc(50% - 165px);
  top: 50%;
}

.line-b {
  width: 330px;
  left: calc(50% - 165px);
  top: 50%;
  transform: rotate(90deg);
}

.line-c {
  width: 270px;
  left: calc(50% - 135px);
  top: 50%;
  transform: rotate(45deg);
}

.line-d {
  width: 270px;
  left: calc(50% - 135px);
  top: 50%;
  transform: rotate(-45deg);
}

.rv-network-node {
  position: absolute;
  width: 120px;
  height: 80px;
  border: 1px solid #303540;
  background: #0d1016;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 15px 40px #0008;
  animation: rvNode 4s ease-in-out infinite;
}

.rv-network-node b {
  color: #d8dcd5;
  font-size: 11px;
}

.rv-network-node small {
  color: var(--rv-neon);
  font: 7px monospace;
  margin-top: 5px;
}

.network-a {
  top: 50%;
  left: 8%;
  transform: translateY(-50%);
}

.network-b {
  top: 50%;
  right: 8%;
  transform: translateY(-50%);
  animation-delay: .7s;
}

.network-c {
  top: 8%;
  left: 50%;
  transform: translateX(-50%);
  animation-delay: 1.2s;
}

.network-d {
  bottom: 8%;
  left: 50%;
  transform: translateX(-50%);
  animation-delay: 1.8s;
}

/* GAMES */

.rv-games-section {
  border-top: 1px solid #191c24;
}

.rv-games-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.rv-game-card {
  background: #0d0f15;
  border: 1px solid #242832;
  transition: .35s;
  transition-delay: var(--delay);
}

.rv-game-card:hover {
  transform: translateY(-9px);
  border-color: #d7ff1f55;
  box-shadow: 0 20px 50px #0008;
}

.rv-game-visual {
  height: 220px;
  background: #11141c;
  position: relative;
  overflow: hidden;
  display: grid;
  place-items: center;
}

.rv-game-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(#ffffff06 1px, transparent 1px),
    linear-gradient(90deg, #ffffff06 1px, transparent 1px);
  background-size: 30px 30px;
}

.rv-game-visual > span {
  position: relative;
  font-size: 85px;
  filter: grayscale(.3);
  transition: .4s;
}

.rv-game-card:hover .rv-game-visual > span {
  transform: scale(1.15) rotate(-4deg);
}

.rv-game-visual em {
  position: absolute;
  top: 12px;
  right: 12px;
  background: var(--rv-neon);
  color: #080900;
  padding: 5px 8px;
  font: 8px monospace;
  font-style: normal;
  font-weight: 900;
}

.rv-game-glow {
  position: absolute;
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: #d7ff1f0d;
  filter: blur(40px);
}

.rv-game-info {
  padding: 20px;
}

.rv-game-index {
  color: #555b66;
  font: 8px monospace;
  letter-spacing: 1px;
}

.rv-game-info h3 {
  margin: 10px 0 5px;
  font-size: 16px;
}

.rv-game-info p {
  color: #717782;
  font-size: 10px;
  margin: 0;
}

.rv-game-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 22px;
}

.rv-game-bottom small {
  color: #5d636d;
  font-size: 8px;
}

.rv-game-bottom button {
  border: 1px solid #333842;
  background: transparent;
  color: var(--rv-neon);
  padding: 8px 10px;
  font: 8px monospace;
}

/* COMI */

.rv-comi {
  padding-top: 150px;
  padding-bottom: 150px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 100px;
  align-items: center;
}

.rv-comi-copy > p {
  color: #7a808a;
  line-height: 1.8;
  font-size: 13px;
  max-width: 420px;
  margin: 30px 0;
}

.rv-chat {
  max-width: 480px;
  width: 100%;
  margin-left: auto;
  border: 1px solid #2b3039;
  background: #0b0e13;
  box-shadow: 0 30px 80px #0008;
}

.rv-chat-top {
  height: 58px;
  border-bottom: 1px solid #22262f;
  padding: 0 17px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rv-chat-top strong {
  font-size: 11px;
  display: block;
}

.rv-chat-top small {
  color: #6e7580;
  font: 7px monospace;
}

.rv-chat-top small span {
  width: 5px;
  height: 5px;
  display: inline-block;
  background: var(--rv-neon);
  border-radius: 50%;
  margin-right: 4px;
}

.rv-chat-top > span {
  border: 1px solid #2e343e;
  padding: 5px 7px;
  color: var(--rv-neon);
  font: 8px monospace;
}

.rv-chat-body {
  padding: 30px;
  min-height: 300px;
}

.rv-bot-avatar {
  width: 48px;
  height: 48px;
  border: 1px solid #d7ff1f44;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--rv-neon);
  margin-bottom: 18px;
  animation: rvCore 3s infinite;
}

.rv-message {
  background: #11151b;
  border: 1px solid #272c34;
  padding: 17px;
  max-width: 310px;
}

.rv-message span {
  color: #dfe2db;
  font-size: 12px;
}

.rv-message p {
  color: #737984;
  font-size: 10px;
  margin: 10px 0 0;
}

.rv-chat-options {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 25px;
}

.rv-chat-options button {
  background: #0e1117;
  border: 1px solid #2a2f38;
  color: #777d87;
  padding: 8px 9px;
  font-size: 8px;
}

.rv-chat-input {
  border-top: 1px solid #22262f;
  padding: 15px;
  color: #4f555f;
  font: 9px monospace;
}

.rv-chat-input span {
  float: right;
  color: var(--rv-neon);
}

/* SECURITY */

.rv-security {
  padding-top: 120px;
  padding-bottom: 130px;
  border-top: 1px solid #191c24;
}

.rv-security-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin: 40px 0 65px;
}

.rv-security-heading p {
  max-width: 310px;
  color: #737984;
  line-height: 1.7;
  font-size: 12px;
}

.rv-security-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.rv-security-card {
  min-height: 220px;
  padding: 25px;
  border: 1px solid #242832;
  background: #0c0f14;
}

.rv-security-card > span {
  color: var(--rv-neon);
  font: 9px monospace;
}

.rv-security-card strong {
  display: block;
  margin: 65px 0 12px;
  font-size: 13px;
}

.rv-security-card p {
  color: #6f7580;
  font-size: 10px;
  line-height: 1.7;
}

/* LIVE */

.rv-live {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid #292d36;
  border-bottom: 1px solid #292d36;
  padding-top: 0;
  padding-bottom: 0;
}

.rv-live > div {
  padding: 25px;
  border-right: 1px solid #292d36;
}

.rv-live > div:last-child {
  border-right: 0;
}

.rv-live span,
.rv-live small {
  display: block;
  color: #555b65;
  font: 8px monospace;
  letter-spacing: 1px;
}

.rv-live strong {
  display: block;
  margin: 8px 0;
  font-size: 20px;
}

.rv-status-online {
  color: var(--rv-neon);
}

/* CTA */

.rv-cta {
  min-height: 650px;
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;
  text-align: center;
}

.rv-cta-content {
  position: relative;
  z-index: 5;
}

.rv-cta h2 {
  margin-top: 30px;
}

.rv-cta p {
  color: #717782;
  font-size: 12px;
  line-height: 1.7;
  margin: 25px 0;
}

.rv-cta-orbit {
  position: absolute;
  width: 550px;
  height: 190px;
  border: 1px solid #d7ff1f30;
  border-radius: 50%;
  transform: rotate(-20deg);
  animation: rvOrbit 18s linear infinite;
}

.rv-cta-orbit::before,
.rv-cta-orbit::after {
  content: "";
  position: absolute;
  border: 1px solid #d7ff1f15;
  border-radius: 50%;
}

.rv-cta-orbit::before {
  inset: -60px;
}

.rv-cta-orbit::after {
  inset: 60px;
}

/* FOOTER */

.rv-footer {
  border-top: 1px solid #22262f;
  padding: 55px 34px 35px;
  max-width: 1240px;
  margin: auto;
  display: grid;
  grid-template-columns: 2fr repeat(4, 1fr);
  gap: 40px;
}

.rv-footer-brand p {
  color: #646a74;
  font-size: 10px;
  line-height: 1.7;
  margin-top: 18px;
}

.rv-footer b {
  display: block;
  color: #d4d8d1;
  font: 9px monospace;
  letter-spacing: 1px;
  margin-bottom: 15px;
}

.rv-footer a,
.rv-footer div > span {
  display: block;
  color: #666c76;
  font-size: 9px;
  margin: 9px 0;
}

.rv-footer a:hover {
  color: var(--rv-neon);
}

/* ANIMATIONS */

@keyframes rvPulse {
  50% {
    opacity: .35;
    box-shadow: 0 0 2px var(--rv-neon);
  }
}

@keyframes rvCore {
  0%,100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-10px) scale(1.025);
  }
}

@keyframes rvOrbit {
  from {
    transform: rotate(-20deg) rotate(0deg);
  }
  to {
    transform: rotate(-20deg) rotate(360deg);
  }
}

@keyframes rvOrbitReverse {
  from {
    transform: rotate(52deg) rotate(360deg);
  }
  to {
    transform: rotate(52deg) rotate(0deg);
  }
}

@keyframes rvBlink {
  0%,100% {
    opacity: .25;
  }
  50% {
    opacity: 1;
  }
}

@keyframes rvNode {
  0%,100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-7px);
  }
}

@keyframes rvLine {
  0%,100% {
    opacity: .3;
  }
  50% {
    opacity: 1;
  }
}

/* MOBILE */

@media (max-width: 800px) {

  .rv-nav {
    height: 65px;
    padding: 0 15px;
    gap: 0;
  }

  .rv-nav-links {
    display: none;
    position: fixed;
    top: 75px;
    left: 15px;
    right: 15px;
    padding: 20px;
    background: #0d0f16;
    border: 1px solid #272b34;
    border-radius: 16px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 4px;
  }

  .rv-nav-links.rv-nav-open {
    display: flex;
    z-index: 999;
  }

  .rv-nav-links a {
    padding: 18px 0;
    border-bottom: 1px solid #1d2028;
    font-size: 20px;
    height: auto;
    display: block;
    width: 100%;
  }

  .rv-nav-actions {
    margin-left: auto;
  }

  .rv-wallet {
    padding: 8px 10px;
    font-size: 8px;
  }

  .rv-menu {
    display: block;
  }

  .rv-hero {
    min-height: 850px;
    display: block;
    padding: 80px 20px 50px;
  }

  .rv-hero h1 {
    font-size: 55px;
    letter-spacing: 0px;
  }

  .rv-hero-copy > p {
    font-size: 12px;
  }

  .rv-hero-buttons {
    flex-direction: column;
    max-width: 240px;
  }

  .rv-hero-stats {
    gap: 20px;
    margin-top: 40px;
  }

  .rv-orbit-scene {
    height: 400px;
    margin-top: 35px;
  }

  .rv-core {
    width: 130px;
    height: 130px;
  }

  .rv-core span {
    font-size: 80px;
  }

  .orbit-one {
    width: 330px;
    height: 130px;
  }

  .orbit-two {
    width: 300px;
    height: 120px;
  }

  .orbit-three {
    width: 370px;
    height: 160px;
  }

  .node-one {
    top: 70px;
    right: 0;
  }

  .node-two {
    bottom: 60px;
    left: 0;
  }

  .node-three {
    top: 150px;
    left: -5px;
  }

  .node-four {
    bottom: 80px;
    right: 0;
  }

  .rv-intro,
  .rv-section,
  .rv-how,
  .rv-security,
  .rv-comi {
    padding-left: 20px;
    padding-right: 20px;
  }

  .rv-intro {
    padding-top: 100px;
    padding-bottom: 100px;
  }

  .rv-intro h2,
  .rv-how h2,
  .rv-universe h2,
  .rv-security h2,
  .rv-comi h2,
  .rv-cta h2 {
    font-size: 43px;
    letter-spacing: 0px;
  }

  .rv-intro-content p {
    margin-left: 0;
    margin-top: 25px;
  }

  .rv-section-top,
  .rv-universe-title,
  .rv-security-heading {
    display: block;
  }

  .rv-section-top > p,
  .rv-universe-title p,
  .rv-security-heading p {
    text-align: left;
    margin-top: 20px;
  }

  .rv-feature-layout {
    grid-template-columns: 1fr;
  }

  .rv-feature-list {
    border-right: 0;
  }

  .rv-feature-item {
    min-height: 75px;
  }

  .rv-feature-display {
    min-height: 420px;
    padding: 30px;
  }

  .rv-display-orb {
    width: 250px;
    height: 250px;
    right: -40px;
    top: 25%;
    opacity: .6;
  }

  .rv-display-content {
    max-width: 80%;
  }

  .rv-display-content h3 {
    font-size: 38px;
  }

  .rv-timeline {
    grid-template-columns: 1fr;
  }

  .rv-step {
    border-right: 0;
    border-bottom: 1px solid #282c34;
  }

  .rv-universe {
    padding-left: 20px;
    padding-right: 20px;
  }

  .rv-network {
    height: 470px;
  }

  .rv-network-center {
    width: 110px;
    height: 110px;
  }

  .rv-network-center strong {
    font-size: 48px;
  }

  .rv-network-node {
    width: 95px;
    height: 65px;
  }

  .network-a {
    left: 0;
  }

  .network-b {
    right: 0;
  }

  .rv-games-grid {
    grid-template-columns: 1fr 1fr;
  }

  .rv-game-visual {
    height: 150px;
  }

  .rv-game-visual > span {
    font-size: 55px;
  }

  .rv-game-info {
    padding: 13px;
  }

  .rv-game-info h3 {
    font-size: 13px;
  }

  .rv-game-bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .rv-comi {
    grid-template-columns: 1fr;
    gap: 50px;
  }

  .rv-chat {
    margin: 0;
  }

  .rv-security-grid {
    grid-template-columns: 1fr;
  }

  .rv-live {
    grid-template-columns: 1fr;
    padding-left: 20px;
    padding-right: 20px;
  }

  .rv-live > div {
    border-right: 0;
    border-bottom: 1px solid #292d36;
  }

  .rv-footer {
    grid-template-columns: 1fr 1fr;
    padding-left: 20px;
    padding-right: 20px;
  }

  .rv-footer-brand {
    grid-column: 1 / -1;
  }

}

@media (max-width: 470px) {

  .rv-hero h1 {
    font-size: 48px;
  }

  .rv-games-grid {
    grid-template-columns: 1fr;
  }

  .rv-game-visual {
    height: 190px;
  }

  .rv-footer {
    grid-template-columns: 1fr 1fr;
  }

}

@media (prefers-reduced-motion: reduce) {
  .rv-site *,
  .rv-site *::before,
  .rv-site *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}


.rv-white {
  color: #fff !important;
}

.rv-green {
  color: #d7ff1f !important;
}

.rv-comi a.rv-primary {
  color: #090a04 !important;
}
.rv-comi a.rv-primary span {
  color: #090a04 !important;
}

.rv-section-top h2 span {
  color: var(--rv-neon);
}
